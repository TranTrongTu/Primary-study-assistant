# Optional: a separate judge for scripts/generation_eval.py. Copy to evals/.env.
# Only the evaluation reads this file; the app never sees the judge's key.
# Any provider with an OpenAI-compatible API works. Leave JUDGE_BASE_URL empty to judge
# with Gemini and the app's own key.

# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1,
#           https://generativelanguage.googleapis.com/v1beta/openai (Gemini),
#           https://api.anthropic.com/v1 (Claude)
JUDGE_BASE_URL =
JUDGE_API_KEY =
JUDGE_MODEL =
# json_schema (Gemini), json_schema_strict (OpenAI, Anthropic), or json_object for a
# provider that does not support schemas
JUDGE_STRUCTURED_OUTPUT = json_schema
# 0 gives the most repeatable verdicts. "omit" for models that refuse it (Claude 4.7
# and later)
JUDGE_TEMPERATURE = 0
